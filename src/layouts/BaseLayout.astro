---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReviewBadge from '../components/ReviewBadge.astro';
import { withBase } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
}

const { title, description, currentPath = Astro.url.pathname, noindex = false } = Astro.props;
const isReviewDeployment = import.meta.env.BASE_URL !== '/';
const shouldNoindex = noindex || isReviewDeployment;
const reviewId = isReviewDeployment ? 'VIA-WEB-R003' : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {shouldNoindex && <meta name="robots" content="noindex, nofollow" />}
    {reviewId && <meta name="via:review-id" content={reviewId} />}
    {reviewId && <meta name="via:review-status" content="EN REVISIÓN" />}
    {reviewId && <meta name="via:review-date" content="2026-08-31" />}
    <meta name="theme-color" content="#F9F9F9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href={withBase('/assets/brand/favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header currentPath={currentPath} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {isReviewDeployment && <ReviewBadge />}
  </body>
</html>
