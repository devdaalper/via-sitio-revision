---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineIcon from '../components/LineIcon.astro';
import WaveBackdrop from '../components/WaveBackdrop.astro';
import { withBase } from '../utils/paths';

const pillars = [
  { icon: 'search', title: 'Sourcing inteligente', copy: 'Atrae al talento correcto desde el inicio.' },
  { icon: 'pool', title: 'Bolsa de talento propia', copy: 'Construye tu propio banco de candidatos sin depender de terceros.' },
  { icon: 'centralize', title: 'Proceso centralizado', copy: 'Todo en un solo lugar, sin herramientas dispersas.' },
  { icon: 'systems', title: 'Integración con cualquier sistema', copy: 'Se conecta a los portales y plataformas que ya usas.' },
  { icon: 'data', title: 'Decisiones respaldadas por datos', copy: 'Tu equipo evalúa con evidencia, no con intuición.' },
] as const;

const metrics = [
  ['−70%', 'Reduce el tiempo de contratación'],
  ['−45%', 'Costos por proceso'],
  ['−70%', 'Tiempo en revisión manual de CVs'],
  ['+50%', 'Eficiencia del equipo de RH'],
];

const capabilities = [
  { icon: 'clarity', title: 'Mejor experiencia para todos', copy: 'Candidatos y reclutadores tienen visibilidad en tiempo real de cada etapa del proceso, sin fricciones ni silencios.' },
  { icon: 'documents', title: 'Validación documental oficial', copy: 'v.ia se integra con portales de gobierno para verificar documentos automáticamente y eliminar riesgos legales desde el inicio.' },
  { icon: 'systems', title: 'Operación global y escalable', copy: 'Multipaís, multi-idioma y multiplataforma. v.ia se adapta a donde está tu operación sin importar el volumen.' },
] as const;
---

<BaseLayout
  title="v.ia | Todo tu reclutamiento en una sola plataforma"
  description="v.ia centraliza y automatiza el reclutamiento con IA, desde la requisición de la vacante hasta la nómina."
  currentPath="/"
>
  <section class="home-hero" aria-labelledby="home-title">
    <WaveBackdrop variant="b" class="hero-wave" />
    <div class="shell hero-content">
      <p class="eyebrow">Plataforma integral de reclutamiento impulsada con IA, desde la requisición hasta la nómina.</p>
      <h1 id="home-title" class="display-title">Todo tu reclutamiento en <mark class="marker">una sola plataforma</mark></h1>
      <p class="lead">v.ia filtra candidatos, realiza evaluaciones, agenda entrevistas, mantiene comunicación y valida documentos para la contratación.</p>
      <a class="btn-primary hero-button" href={withBase('/contacto')}>Solicita un demo <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section-space-sm video-section" aria-labelledby="video-title">
    <div class="shell video-layout">
      <div class="video-heading">
        <p class="eyebrow">Menos tiempo operativo</p>
        <h2 id="video-title" class="section-title">Reduce hasta un <mark class="marker">70%</mark> el tiempo de cada contratación.</h2>
      </div>
      <div class="video-frame">
        <iframe
          src="https://drive.google.com/file/d/1ZrSFL7qfZDn-FJLkqIr_8mEJzWNv_S3x/preview"
          title="Video corporativo de v.ia"
          loading="lazy"
          allow="autoplay; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="section-space pillars-section" aria-labelledby="pillars-title">
    <div class="shell pillars-layout">
      <div class="pillars-heading">
        <p class="eyebrow">Una operación conectada</p>
        <h2 id="pillars-title" class="section-title"><mark class="marker">Pilares</mark> que transforman tu reclutamiento</h2>
      </div>
      <ol class="pillar-list">
        {pillars.map((pillar, index) => (
          <li>
            <span class="pillar-index">{String(index + 1).padStart(2, '0')}</span>
            <span class="pillar-icon" aria-hidden="true"><LineIcon name={pillar.icon} /></span>
            <div><h3>{pillar.title}</h3><p>{pillar.copy}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="human-section" aria-labelledby="human-title">
    <div class="shell human-panel">
      <WaveBackdrop variant="a" class="human-wave" />
      <div class="human-copy">
        <p class="eyebrow eyebrow-on-dark">Lo importante del proceso es <strong>lo humano.</strong></p>
        <h2 id="human-title" class="section-title section-title-on-dark">v.ia ejecuta. Tú mantienes el control.</h2>
        <p class="lead lead-on-dark">v.ia se encarga de lo operativo para que tu equipo de RH deje de ejecutar y empiece a estrategizar: menos revisión de CVs, más tiempo para el clima laboral, los líderes y las decisiones que realmente importan.</p>
      </div>
      <img src={withBase('/assets/photography/home-recruiter-cutout-v1.webp')} alt="" width="1024" height="1536" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="section-space metrics-section" aria-labelledby="metrics-title">
    <div class="shell">
      <div class="metrics-heading">
        <p class="eyebrow">Números que hablan por sí solos.</p>
        <h2 id="metrics-title" class="section-title">Resultados reales, <mark class="marker">no promesas.</mark></h2>
      </div>
      <div class="metrics-grid">
        {metrics.map(([value, label]) => (
          <article><strong>{value}</strong><p>{label}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="process-teaser" aria-labelledby="process-title">
    <WaveBackdrop variant="a" class="process-wave" />
    <div class="shell process-teaser-inner">
      <div>
        <p class="eyebrow eyebrow-on-dark">Cómo funciona</p>
        <h2 id="process-title" class="section-title section-title-on-dark">v.ia automatiza para que <span class="lime-text">tu equipo decida.</span></h2>
      </div>
      <div class="process-teaser-copy">
        <p>Más de 8 etapas del proceso de reclutamiento automatizadas en v.ia</p>
        <a class="btn-primary" href={withBase('/plataforma')}>Conoce el proceso completo <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section-space capabilities-section" aria-labelledby="capabilities-title">
    <div class="shell">
      <div class="capabilities-heading">
        <p class="eyebrow">Preparada para crecer contigo</p>
        <h2 id="capabilities-title" class="section-title">Diseñado para operar <mark class="marker">sin límites.</mark></h2>
        <p class="lead">Tres capacidades que hacen de v.ia una plataforma lista para cualquier operación, industria y escala.</p>
      </div>
      <div class="capability-band">
        {capabilities.map((capability) => (
          <article>
            <span aria-hidden="true"><LineIcon name={capability.icon} /></span>
            <h3>{capability.title}</h3>
            <p>{capability.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <WaveBackdrop variant="b" class="closing-wave" />
    <div class="shell closing-content">
      <h2 id="closing-title" class="section-title section-title-on-dark">¿Listo para llevar tu reclutamiento al siguiente nivel con v.ia?</h2>
      <p class="lead lead-on-dark">En 30 minutos te mostramos cómo v.ia reduce tiempos, elimina tareas manuales y devuelve el control a tu equipo de RH.</p>
      <a class="btn-primary" href={withBase('/contacto')}>Solicitar demo <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .marker { position: relative; z-index: 0; display: inline; background: none; color: inherit; }
  .marker::after { position: absolute; z-index: -1; right: -.08em; bottom: .06em; left: -.08em; height: .27em; background: #e1fe66; content: ""; }
  .lime-text { color: #e1fe66; }
  .home-hero { position: relative; overflow: hidden; padding-block: clamp(74px,10vw,132px); }
  :global(.hero-wave) { top: 50%; left: 50%; width: min(1080px,92vw); transform: translate(-50%,-50%); opacity: .25; }
  .hero-content { position: relative; display: grid; justify-items: center; text-align: center; }
  .hero-content .eyebrow { max-width: 82ch; justify-content: center; }
  .hero-content .display-title { max-width: 15ch; }
  .hero-content .lead { max-width: 72ch; }
  .hero-button { margin-top: 30px; border-color: #161a23; background: #161a23; color: #f9f9f9; }
  .hero-button:hover { border-color: #27414f; background: #27414f; }
  .video-section { background: #edebdf; }
  .video-layout { display: grid; grid-template-columns: .72fr 1.28fr; align-items: center; gap: clamp(48px,8vw,104px); }
  .video-frame { position: relative; overflow: hidden; aspect-ratio: 16/9; border-radius: 28px; background: #161a23; box-shadow: 0 24px 58px rgba(22,26,35,.14); }
  .video-frame iframe { width: 100%; height: 100%; border: 0; }
  .pillars-layout { display: grid; grid-template-columns: .76fr 1.24fr; align-items: start; gap: clamp(54px,9vw,124px); }
  .pillars-heading { position: sticky; top: 130px; }
  .pillar-list { margin: 0; padding: 0; list-style: none; }
  .pillar-list li { display: grid; grid-template-columns: 42px 48px 1fr; align-items: start; gap: 18px; border-top: 1px solid rgba(39,65,79,.17); padding-block: 24px; }
  .pillar-list li:last-child { border-bottom: 1px solid rgba(39,65,79,.17); }
  .pillar-index { color: #27414f; font-size: .875rem; font-weight: 850; letter-spacing: .08em; padding-top: 10px; }
  .pillar-icon { display: grid; width: 48px; height: 48px; place-items: center; border-radius: 50%; background: #edebdf; color: #27414f; }
  .pillar-icon :global(.line-icon) { width: 27px; height: 27px; stroke-width: 1.3; }
  .pillar-list h3 { display: inline-block; margin: 0; border-radius: 8px; background: #161a23; color: #e1fe66; padding: 6px 10px; font-size: 1.05rem; line-height: 1.25; }
  .pillar-list p { margin: 7px 0 0; color: #27414f; font-size: 1rem; line-height: 1.55; }
  .human-section { padding: 12px; }
  .human-panel { position: relative; display: grid; min-height: 560px; overflow: hidden; grid-template-columns: 1.06fr .94fr; align-items: center; border-radius: 34px; background: #161a23; color: #edebdf; padding: clamp(52px,8vw,96px); }
  :global(.human-wave) { top: -38%; right: -15%; width: 760px; opacity: .48; }
  .human-copy { position: relative; z-index: 2; }
  .human-copy .eyebrow strong { color: #e1fe66; }
  .human-panel > img { position: absolute; z-index: 1; right: 2%; bottom: -9%; width: min(43%,430px); height: 92%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 20px 24px rgba(22,26,35,.24)); }
  .metrics-heading { display: grid; justify-items: center; text-align: center; }
  .metrics-grid { display: grid; grid-template-columns: repeat(4,1fr); margin-top: 54px; border-block: 1px solid rgba(39,65,79,.18); }
  .metrics-grid article { min-height: 230px; border-right: 1px solid rgba(39,65,79,.16); padding: 42px clamp(22px,3vw,38px); }
  .metrics-grid article:last-child { border-right: 0; }
  .metrics-grid strong { display: inline-block; border-radius: 14px; background: #161a23; color: #e1fe66; padding: 12px 15px 10px; font-size: clamp(2.5rem,5vw,4.4rem); font-weight: 780; letter-spacing: -.055em; line-height: 1; }
  .metrics-grid p { margin: 22px 0 0; color: #27414f; font-size: 1rem; font-weight: 650; line-height: 1.5; }
  .process-teaser { position: relative; overflow: hidden; background: #161a23; padding-block: clamp(70px,8vw,102px); }
  :global(.process-wave) { top: -155%; left: 31%; width: 980px; opacity: .52; }
  .process-teaser-inner { position: relative; display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; gap: clamp(52px,9vw,120px); }
  .process-teaser-copy { display: grid; justify-items: start; gap: 24px; }
  .process-teaser-copy p { max-width: 35ch; margin: 0; color: rgba(237,235,223,.78); font-size: 1.08rem; }
  .capabilities-heading { max-width: 790px; }
  .capability-band { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 58px; border-block: 1px solid rgba(39,65,79,.18); }
  .capability-band article { border-right: 1px solid rgba(39,65,79,.16); padding: 40px clamp(28px,4vw,52px) 46px; }
  .capability-band article:last-child { border-right: 0; }
  .capability-band article > span { display: grid; width: 68px; height: 68px; place-items: center; border-radius: 50%; background: #161a23; color: #e1fe66; }
  .capability-band article > span :global(.line-icon) { width: 36px; height: 36px; stroke-width: 1.25; }
  .capability-band h3 { display: inline-block; margin: 26px 0 0; border-radius: 8px; background: #161a23; color: #e1fe66; padding: 6px 10px; font-size: 1.05rem; line-height: 1.25; }
  .capability-band p { margin: 12px 0 0; color: #27414f; font-size: 1rem; line-height: 1.6; }
  .closing-section { position: relative; overflow: hidden; margin: 12px; border-radius: 34px 34px 0 0; background: #161a23; padding-block: clamp(76px,9vw,112px); }
  :global(.closing-wave) { top: -80%; left: 45%; width: 900px; opacity: .48; }
  .closing-content { position: relative; display: grid; justify-items: center; text-align: center; }
  .closing-content .section-title { max-width: 21ch; }
  .closing-content .lead { max-width: 63ch; }
  .closing-content .btn-primary { margin-top: 30px; }
  @media (max-width: 920px) {
    .video-layout, .pillars-layout, .process-teaser-inner { grid-template-columns: 1fr; }
    .pillars-heading { position: static; }
    .human-panel { grid-template-columns: 1fr; padding-bottom: 340px; }
    .human-panel > img { right: 50%; bottom: -6%; width: min(70%,390px); height: 48%; transform: translateX(50%); }
    .metrics-grid { grid-template-columns: repeat(2,1fr); }
    .metrics-grid article:nth-child(2) { border-right: 0; }
    .metrics-grid article:nth-child(-n+2) { border-bottom: 1px solid rgba(39,65,79,.16); }
    .capability-band { grid-template-columns: 1fr; }
    .capability-band article { border-right: 0; border-bottom: 1px solid rgba(39,65,79,.16); }
    .capability-band article:last-child { border-bottom: 0; }
  }
  @media (max-width: 600px) {
    .home-hero { padding-block: 56px 72px; }
    :global(.hero-wave) { width: 720px; opacity: .19; }
    .hero-content .eyebrow { font-size: .875rem; line-height: 1.45; }
    .video-frame { border-radius: 22px; }
    .pillar-list li { grid-template-columns: 32px 42px 1fr; gap: 12px; }
    .pillar-icon { width: 42px; height: 42px; }
    .human-section { padding: 7px; }
    .human-panel { min-height: 710px; border-radius: 25px; padding: 54px 24px 320px; }
    .metrics-grid { grid-template-columns: 1fr; }
    .metrics-grid article { min-height: 0; border-right: 0; border-bottom: 1px solid rgba(39,65,79,.16); padding: 32px 4px; }
    .metrics-grid article:nth-child(-n+2) { border-bottom: 1px solid rgba(39,65,79,.16); }
    .metrics-grid article:last-child { border-bottom: 0; }
    .process-teaser { padding-block: 66px; }
    :global(.process-wave) { top: -50%; left: -95%; width: 720px; }
    .capability-band article { padding-inline: 8px; }
    .closing-section { margin: 7px; border-radius: 25px 25px 0 0; }
    :global(.closing-wave) { top: -30%; left: -75%; width: 720px; }
  }
</style>
