---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Términos pendientes | V.IA"
  description="Ruta técnica reservada para los términos aprobados de V.IA."
  currentPath="/terminos"
  noindex={true}
>
  <section class="legal-pending">
    <div class="shell legal-card panel">
      <p class="eyebrow">Documento legal</p>
      <h1 class="page-title">Términos pendientes de publicación.</h1>
      <p class="lead">Esta ruta está preparada, pero no sustituye los términos legales de V.IA. El documento se publicará después de recibirlo y revisarlo.</p>
      <a class="text-link" href={withBase('/')}>Volver al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-pending { padding-block: clamp(72px,10vw,130px); }
  .legal-card { padding: clamp(24px,7vw,80px); }
  .legal-card .text-link { margin-top: 28px; }
</style>
