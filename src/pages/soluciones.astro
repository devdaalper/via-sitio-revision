---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineIcon from '../components/LineIcon.astro';
import WaveBackdrop from '../components/WaveBackdrop.astro';
import { withBase } from '../utils/paths';

const interviews = [
  { icon: 'interview', title: 'Entrevista por chat', copy: 'Conversación automatizada que evalúa al candidato en tiempo real.' },
  { icon: 'video', title: 'Entrevista por videollamada', copy: 'V.IA conduce y registra la entrevista sin necesidad de un reclutador presente.' },
  { icon: 'data', title: 'Resultados integrados', copy: 'Todo queda en el expediente del candidato listo para que tu equipo evalúe.' },
] as const;

const integrations = [
  { icon: 'government', title: 'IMSS y RENAPO', copy: 'Validación oficial de identidad y registros del candidato en tiempo real.' },
  { icon: 'jobs', title: 'Bolsas de empleo', copy: 'Descarga automática de CVs desde los portales que ya usas.' },
  { icon: 'payroll', title: 'Sistemas de nómina', copy: 'Alta del colaborador directo desde V.IA sin salir de la plataforma.' },
  { icon: 'systems', title: 'Comunicación y sistemas de talento', copy: 'Integra Office 365, WhatsApp, CRM, ATS y HCM para conectar comunicación, candidatos y operación.' },
  { icon: 'documents', title: 'Evaluación y firma digital', copy: 'Conecta plataformas de psicometría y firma digital para completar el proceso sin salir de V.IA.' },
] as const;

const roles = [
  { icon: 'leader', title: 'Director de RH', copy: 'Visibilidad total, datos para reportar y tiempo para lo estratégico.' },
  { icon: 'recruiter', title: 'Reclutador', copy: 'Menos operación, más candidatos relevantes y decisiones con criterio.' },
  { icon: 'data', title: 'Director General', copy: 'Vacantes cubiertas más rápido, costos controlados y RH estratégico.' },
] as const;
---

<BaseLayout
  title="Soluciones V.IA | IA, automatización e integraciones"
  description="Conoce cómo V.IA combina entrevistas con IA, automatización e integraciones para cada rol del proceso de reclutamiento."
  currentPath="/soluciones"
  connectFooter
>
  <section class="page-hero" aria-labelledby="page-title">
    <WaveBackdrop variant="b" class="hero-wave" />
    <div class="shell hero-content">
      <p class="eyebrow">Lo que V.IA hace por tu equipo</p>
      <h1 id="page-title" class="page-title">Más que una plataforma. <mark class="marker">Un equipo que trabaja por ti.</mark></h1>
      <p class="lead"><span class="accent-text">V.IA</span> combina inteligencia artificial, automatización e integraciones para que tu proceso de reclutamiento opere solo, mientras tu equipo se enfoca en decidir.</p>
    </div>
  </section>

  <section class="section-space interviews-section" aria-labelledby="interviews-title">
    <div class="shell section-heading">
      <p class="eyebrow">Agentes con IA</p>
      <h2 id="interviews-title" class="section-title">Entrevistas reales, que le <mark class="marker">ahorran tiempo a tu equipo.</mark></h2>
      <p class="lead"><span class="accent-text">V.IA</span> <strong>realiza filtros por chat, llamada de audio o videollamada</strong>; evalúa respuestas y concentra los resultados en el expediente del candidato, sin que el reclutador tenga que intervenir.</p>
    </div>
    <div class="shell feature-band interview-band">
      {interviews.map((item) => (
        <article>
          <span class="feature-icon" aria-hidden="true"><LineIcon name={item.icon} /></span>
          <h3>{item.title}</h3>
          <p set:html={item.title === 'Entrevista por chat'
            ? 'Conversación automatizada que <strong>evalúa al candidato en tiempo real.</strong>'
            : item.title === 'Entrevista por videollamada'
              ? '<strong class="accent-text">V.IA</strong> conduce y <strong>registra la entrevista</strong> sin necesidad de un reclutador presente.'
              : '<strong>Todo queda en el expediente</strong> del candidato listo para que tu equipo evalúe.'} />
        </article>
      ))}
    </div>
  </section>

  <section class="integrations-section" aria-labelledby="integrations-title">
    <WaveBackdrop variant="a" class="integrations-wave" />
    <div class="shell integrations-layout">
      <div class="integrations-copy">
        <p class="eyebrow eyebrow-on-dark">Conectado a tu operación</p>
        <h2 id="integrations-title" class="section-title section-title-on-dark">Se integra con los sistemas que ya usas.</h2>
        <p class="lead lead-on-dark"><span class="accent-text">V.IA</span> se conecta con portales de gobierno, plataformas de nómina y bolsas de empleo para <strong>centralizar todo sin duplicar información ni procesos.</strong></p>
      </div>
      <div class="integration-list">
        {integrations.map((item) => (
          <article>
            <div class="integration-icon" aria-hidden="true"><LineIcon name={item.icon} /></div>
            <div><h3>{item.title}</h3><p set:html={item.copy.replaceAll('V.IA', '<strong class="accent-text">V.IA</strong>')} /></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-space roles-section" aria-labelledby="roles-title">
    <div class="shell roles-heading">
      <p class="eyebrow">Diseñado para cada rol</p>
      <h2 id="roles-title" class="section-title"><mark class="marker">V.IA trabaja para todos</mark> los que participan en el proceso.</h2>
      <p class="lead">Cada área tiene necesidades distintas. <span class="accent-text">V.IA</span> se adapta a lo que cada rol necesita.</p>
    </div>
    <div class="shell roles-band">
      {roles.map((role) => (
        <article>
          <span aria-hidden="true"><LineIcon name={role.icon} /></span>
          <h3>{role.title}</h3>
          <p set:html={role.title === 'Director de RH'
            ? 'Visibilidad total, datos para reportar y <strong>tiempo para lo estratégico.</strong>'
            : role.title === 'Reclutador'
              ? 'Menos operación, <strong>más candidatos relevantes</strong> y decisiones con criterio.'
              : '<strong>Vacantes cubiertas más rápido</strong>, costos controlados y RH estratégico.'} />
        </article>
      ))}
    </div>
    <div class="shell role-access">
      <p class="eyebrow">Control y visibilidad por rol</p>
      <p class="lead">Cada equipo accede a la información que necesita, con <strong>permisos configurados según su nivel de responsabilidad:</strong> Director, Gerente o Reclutador.</p>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <WaveBackdrop variant="b" class="closing-wave" />
    <div class="shell closing-content">
      <h2 id="closing-title" class="section-title section-title-on-dark">Descubre cómo <mark class="marker marker-on-dark">V.IA se adapta a tu empresa.</mark></h2>
      <p class="lead lead-on-dark">Cuéntanos cómo recluta tu empresa hoy y te mostramos qué solución encaja mejor con tu proceso.</p>
      <a class="btn-primary" href={withBase('/contacto')}>Habla con un especialista <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .marker { display: inline; border-radius: .06em; background: #e1fe66; box-decoration-break: clone; color: #161a23; padding-inline: .06em; -webkit-box-decoration-break: clone; }
  .marker-on-dark { border-radius: .08em; background: #e1fe66; box-decoration-break: clone; color: #161a23; padding-inline: .08em; -webkit-box-decoration-break: clone; }
  :global(.accent-text) { color: #8dbd2f; font-weight: 800; }
  .page-hero { position: relative; overflow: hidden; padding-block: clamp(72px,9vw,118px); }
  :global(.hero-wave) { top: 50%; left: 50%; width: min(1050px,92vw); transform: translate(-50%,-50%); opacity: .23; }
  .hero-content { position: relative; display: grid; justify-items: center; text-align: center; }
  .hero-content .page-title { max-width: 18ch; }
  .hero-content .lead { max-width: 74ch; }
  .section-heading, .roles-heading { max-width: 850px; }
  .feature-band, .roles-band { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 58px; border-block: 1px solid rgba(39,65,79,.18); }
  .feature-band article, .roles-band article { border-right: 1px solid rgba(39,65,79,.16); padding: 40px clamp(28px,4vw,52px) 44px; }
  .feature-band article:last-child, .roles-band article:last-child { border-right: 0; }
  .feature-icon, .roles-band article > span { display: grid; width: 72px; height: 72px; place-items: center; border-radius: 50%; background: #161a23; color: #e1fe66; }
  .feature-icon :global(.line-icon), .roles-band article > span :global(.line-icon) { width: 38px; height: 38px; stroke-width: 1.25; }
  .feature-band h3, .roles-band h3 { margin: 25px 0 0; color: #8dbd2f; font-size: 1.05rem; font-weight: 780; line-height: 1.25; }
  .feature-band p, .roles-band p { margin: 12px 0 0; color: #27414f; font-size: 1rem; line-height: 1.62; }
  .integrations-section { position: relative; overflow: hidden; background: #161a23; padding-block: clamp(76px,9vw,116px); }
  :global(.integrations-wave) { top: -42%; left: -10%; width: 860px; opacity: .45; -webkit-mask-image: radial-gradient(ellipse at 28% 28%, #161a23 0 44%, rgba(22,26,35,.88) 56%, transparent 78%); mask-image: radial-gradient(ellipse at 28% 28%, #161a23 0 44%, rgba(22,26,35,.88) 56%, transparent 78%); }
  .integrations-section::after { position: absolute; z-index: 0; inset: 0; background: linear-gradient(to bottom, #161a23 0%, rgba(22,26,35,0) 15%, rgba(22,26,35,0) 84%, #161a23 100%); content: ""; pointer-events: none; }
  .integrations-layout { position: relative; z-index: 1; display: grid; grid-template-columns: .85fr 1.15fr; align-items: start; gap: clamp(54px,9vw,116px); }
  .integrations-copy { position: sticky; top: 132px; }
  .integration-list { display: grid; }
  .integration-list article { display: grid; grid-template-columns: 54px 1fr; align-items: center; gap: 17px; border-top: 1px solid rgba(237,235,223,.17); padding-block: 26px; }
  .integration-list article:last-child { border-bottom: 1px solid rgba(237,235,223,.17); }
  .integration-icon { display: grid; width: 54px; height: 54px; place-items: center; border-radius: 50%; background: #edebdf; color: #27414f; }
  .integration-icon :global(.line-icon) { width: 30px; height: 30px; stroke-width: 1.25; }
  .integration-list h3 { margin: 4px 0 0; color: #e1fe66; font-size: 1.15rem; }
  .integration-list p { margin: 8px 0 0; color: rgba(237,235,223,.74); font-size: 1rem; line-height: 1.58; }
  .role-access { margin-top: 46px; border-top: 1px solid rgba(39,65,79,.18); padding-top: 34px; }
  .role-access .lead { max-width: 72ch; }
  .closing-section { position: relative; overflow: hidden; margin: 12px 12px 0; border-radius: 34px 34px 0 0; background: #161a23; padding-block: clamp(76px,9vw,112px); }
  :global(.closing-wave) { top: -118%; right: -12%; left: auto; width: 820px; opacity: .38; }
  .closing-section::after { position: absolute; z-index: 0; inset: 0; background: linear-gradient(to bottom, #161a23 0%, rgba(22,26,35,0) 22%, rgba(22,26,35,0) 76%, #161a23 100%); content: ""; pointer-events: none; }
  .closing-content { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; }
  .closing-content .section-title { max-width: 20ch; }
  .closing-content .lead { max-width: 63ch; }
  .closing-content .btn-primary { margin-top: 30px; }
  @media (max-width: 860px) {
    .feature-band, .roles-band { grid-template-columns: 1fr; }
    .feature-band article, .roles-band article { border-right: 0; border-bottom: 1px solid rgba(39,65,79,.16); }
    .feature-band article:last-child, .roles-band article:last-child { border-bottom: 0; }
    .integrations-layout { grid-template-columns: 1fr; }
    .integrations-copy { position: static; }
  }
  @media (max-width: 520px) {
    .page-hero { padding-block: 54px 70px; }
    :global(.hero-wave) { width: 720px; opacity: .18; }
    .feature-band article, .roles-band article { padding-inline: 8px; }
    .integration-list article { grid-template-columns: 46px 1fr; gap: 12px; }
    .integration-icon { width: 46px; height: 46px; }
    .closing-section { margin: 7px 7px 0; border-radius: 25px 25px 0 0; }
    :global(.closing-wave) { display: none; }
  }
</style>
