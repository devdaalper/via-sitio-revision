---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ClosingCta from '../components/ClosingCta.astro';
import LineIcon from '../components/LineIcon.astro';
import { withBase } from '../utils/paths';

const startSteps = [
  ['01', 'Configura la vacante', 'Define el perfil, los requisitos y las etapas que necesita la posición.'],
  ['02', 'Publica y atrae', 'Activa la vacante en tu portal y en las fuentes conectadas a la operación.'],
  ['03', 'Reúne las candidaturas', 'Recibe perfiles desde los canales disponibles y concentra su avance en un mismo proceso.'],
];

const contextSteps = [
  ['04', 'Organiza los perfiles', 'Integra la trayectoria y los datos del CV en una ficha que conserva el contexto de la persona.'],
  ['05', 'Filtra y prioriza', 'Aplica cuestionarios y criterios de la vacante; la IA organiza la compatibilidad y presenta la evidencia disponible.'],
  ['06', 'Realiza la primera entrevista', 'v.ia conduce la primera entrevista y reúne sus resultados dentro del mismo recorrido.'],
];

const hireSteps = [
  ['07', 'Evalúa y decide', 'Tu equipo revisa la evidencia, conversa con el talento y elige quién avanza.'],
  ['08', 'Completa el expediente', 'Reúne los documentos requeridos y prepara la información necesaria para continuar la contratación.'],
  ['09', 'Contrata e integra', 'Prepara el contrato, acompaña la firma y conecta la contratación confirmada con el proceso de alta.'],
];
---

<BaseLayout
  title="Cómo funciona v.ia | Plataforma de reclutamiento con IA"
  description="Conoce cómo v.ia coordina vacantes, candidatos, filtros, entrevistas, documentos y contratación en un proceso conectado de punta a punta."
  currentPath="/plataforma"
>
  <PageHero
    eyebrow="Plataforma de reclutamiento con IA"
    title="Un proceso conectado, de la vacante al primer día."
    lead="v.ia reúne vacantes, perfiles, entrevistas, documentos y conversaciones para llevar cada contratación hasta su incorporación."
    responsibility="La plataforma coordina. La IA prepara contexto. Tu equipo decide."
  />

  <section class="section-space process-block surface-block" aria-labelledby="start-title">
    <div class="shell process-layout">
      <div class="process-heading">
        <p class="eyebrow">Inicia con criterios claros</p>
        <h2 id="start-title" class="section-title">Cada contratación comienza con una vacante bien definida.</h2>
      </div>
      <ol class="step-stack">
        {startSteps.map(([number, title, copy]) => (
          <li><span class="number-medallion">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-space process-block" aria-labelledby="context-title">
    <div class="shell process-layout process-reverse">
      <div class="context-visual" role="img" aria-label="Representación editorial de criterios que forman contexto para una decisión">
        <span class="context-kicker">Contexto reunido</span>
        <div class="context-ledger" aria-hidden="true">
          <div><span>04</span><LineIcon name="attract" /><strong>Trayectoria y CV</strong></div>
          <div><span>05</span><LineIcon name="clarity" /><strong>Filtros y criterios</strong></div>
          <div><span>06</span><LineIcon name="interview" /><strong>Primera entrevista</strong></div>
          <p><LineIcon name="decide" /><span><small>IA asistiva</small><strong>Contexto para revisar</strong></span></p>
        </div>
      </div>
      <div>
        <p class="eyebrow">Convierte información en contexto</p>
        <h2 id="context-title" class="section-title">Conoce cada perfil antes de decidir.</h2>
        <ol class="step-stack compact-stack">
          {contextSteps.map(([number, title, copy]) => (
            <li><span class="number-medallion">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>
          ))}
        </ol>
        <p class="decision-note">La recomendación ayuda a ordenar la revisión. La decisión permanece en tu equipo.</p>
      </div>
    </div>
  </section>

  <section class="section-space process-block dark-process" aria-labelledby="hire-title">
    <div class="shell process-layout">
      <div class="process-heading">
        <p class="eyebrow eyebrow-on-dark">Lleva la decisión a la contratación</p>
        <h2 id="hire-title" class="section-title section-title-on-dark">La información acompaña el proceso hasta la incorporación.</h2>
        <p class="territory-note">
          <strong>México</strong> · v.ia puede consultar SAT, IMSS y RENAPO para validar datos antes del alta en nómina.
        </p>
      </div>
      <ol class="step-stack step-stack-dark">
        {hireSteps.map(([number, title, copy]) => (
          <li><span class="number-medallion">{number}</span><div><h3>{title}</h3><p>{copy}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section-space talent-pool" aria-labelledby="pool-title">
    <div class="shell">
      <div class="pool-intro">
        <p class="eyebrow">Conserva la relación con el talento</p>
        <h2 id="pool-title" class="section-title">Cada proceso fortalece una bolsa propia.</h2>
        <p class="lead">
          El perfil y el historial reunido permiten volver a encontrar talento conocido para oportunidades futuras,
          de acuerdo con el consentimiento y las políticas de privacidad aplicables.
        </p>
      </div>
      <div class="pool-grid">
        <article><span>01</span><h3>Comunicación</h3><p>Mantén las indicaciones y los mensajes correspondientes a cada etapa.</p></article>
        <article><span>02</span><h3>Continuidad</h3><p>Acompaña la relación desde el primer contacto hasta el primer día.</p></article>
        <article><span>03</span><h3>Nuevas oportunidades</h3><p>Vuelve a relacionar perfiles conocidos con vacantes que pueden encajar más adelante.</p></article>
      </div>
    </div>
  </section>

  <section class="section-space-sm systems-section" aria-labelledby="systems-title">
    <div class="shell systems-panel">
      <div>
        <p class="eyebrow">Conecta el recorrido con tu operación</p>
        <h2 id="systems-title" class="section-title">Conecta el proceso con reclutamiento, Recursos Humanos y nómina.</h2>
        <p class="lead">
          v.ia puede integrarse con ATS, HRIS y sistemas de nómina. El alcance depende de las interfaces,
          los permisos y el proyecto de implementación.
        </p>
      </div>
      <div class="systems-map" style={`--wave-url: url("${withBase('/assets/brand/wave-a.png')}")`} role="img" aria-label="v.ia conectada con ATS, HRIS y sistemas de nómina">
        <div class="systems-icon"><LineIcon name="systems" /></div>
        <div class="systems-route"><span>ATS</span><i></i><strong>v.ia</strong><i></i><span>HRIS</span><i></i><span>Nómina</span></div>
      </div>
    </div>
  </section>

  <ClosingCta
    title="Recorre tu proceso dentro de v.ia."
    copy="Una demostración permite revisar cómo estas etapas pueden adaptarse a tus perfiles, sistemas y operación."
  />
</BaseLayout>

<style>
  .surface-block { background: #edebdf; }
  .process-layout { display: grid; grid-template-columns: .9fr 1.1fr; align-items: start; gap: clamp(56px,9vw,120px); }
  .process-heading { position: sticky; top: 122px; }
  .step-stack { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .step-stack li { display: grid; grid-template-columns: 62px 1fr; gap: 24px; border-top: 1px solid rgba(39,65,79,.18); padding-block: 28px; }
  .step-stack li:first-child { border-top: 0; padding-top: 0; }
  .step-stack h3 { margin: 3px 0 0; color: #161a23; font-size: 1.18rem; line-height: 1.3; }
  .step-stack p { margin: 10px 0 0; color: #27414f; }
  .process-reverse { grid-template-columns: 1fr 1fr; align-items: center; }
  .compact-stack { margin-top: 42px; }
  .compact-stack .number-medallion { width: 54px; height: 54px; flex-basis: 54px; }
  .compact-stack li { grid-template-columns: 54px 1fr; gap: 20px; padding-block: 22px; }
  .decision-note { margin: 24px 0 0; border-left: 2px solid #8dbd2f; color: #27414f; padding-left: 16px; font-size: 1rem; line-height: 1.6; }

  .context-visual { position: relative; min-height: 440px; padding: 44px 18px 32px 38px; }
  .context-visual::before, .context-visual::after { position: absolute; border: 1px solid rgba(39,65,79,.13); border-radius: 20px; background: #edebdf; content: ""; }
  .context-visual::before { inset: 62px 0 62px 48px; transform: rotate(2.2deg); opacity: .62; }
  .context-visual::after { inset: 50px 15px 74px 34px; transform: rotate(-1.4deg); opacity: .84; }
  .context-kicker { position: relative; z-index: 3; display: inline-block; margin-left: 24px; color: #27414f; font-size: .875rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
  .context-ledger { position: relative; z-index: 2; overflow: hidden; margin-top: 18px; border-radius: 20px; background: #f9f9f9; box-shadow: 0 20px 44px rgba(22,26,35,.1); }
  .context-ledger > div { display: grid; grid-template-columns: 42px 36px 1fr; align-items: center; gap: 13px; margin-inline: 26px; border-top: 1px solid rgba(39,65,79,.16); padding-block: 18px; }
  .context-ledger > div:first-child { border-top: 0; }
  .context-ledger > div > span { color: #27414f; font-size: .875rem; font-weight: 850; }
  .context-ledger > div :global(.line-icon) { width: 29px; height: 29px; color: #27414f; stroke-width: 1.25; }
  .context-ledger > div strong { color: #27414f; font-size: 1rem; }
  .context-ledger > p { display: grid; grid-template-columns: 44px 1fr; align-items: center; gap: 16px; margin: 0; background: #161a23; color: #edebdf; padding: 22px 26px; }
  .context-ledger > p :global(.line-icon) { color: #e1fe66; }
  .context-ledger > p span { display: grid; gap: 3px; }
  .context-ledger > p small { color: rgba(237,235,223,.72); font-size: .875rem; }
  .context-ledger > p strong { font-size: 1rem; }

  .dark-process { background: #161a23; }
  .dark-process .process-heading { color: #edebdf; }
  .step-stack-dark li { border-color: rgba(237,235,223,.16); }
  .step-stack-dark h3 { color: #edebdf; }
  .step-stack-dark p { color: rgba(237,235,223,.68); }
  .territory-note { margin: 32px 0 0; border-top: 1px solid rgba(237,235,223,.16); color: rgba(237,235,223,.72); padding-top: 22px; font-size: 1rem; line-height: 1.6; }
  .territory-note strong { color: #e1fe66; }

  .pool-intro { max-width: 760px; }
  .pool-grid { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 56px; border-block: 1px solid rgba(39,65,79,.2); }
  .pool-grid article { position: relative; min-height: 260px; border-right: 1px solid rgba(39,65,79,.16); padding: 34px clamp(28px,4vw,52px) 38px; }
  .pool-grid article:last-child { border-right: 0; }
  .pool-grid article::before { position: absolute; top: 36px; left: 28px; width: 8px; height: 8px; background: #8dbd2f; content: ""; }
  .pool-grid span { display: block; margin-left: 22px; color: #27414f; font-size: .875rem; font-weight: 850; }
  .pool-grid h3 { margin: 48px 0 0; color: #161a23; font-size: 1.18rem; }
  .pool-grid p { margin: 12px 0 0; color: #27414f; }

  .systems-section { background: #f9f9f9; }
  .systems-panel { display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(52px,8vw,100px); background: transparent; padding-block: clamp(64px,8vw,92px); }
  .systems-map { position: relative; display: grid; min-height: 286px; overflow: hidden; align-content: center; justify-items: center; gap: 24px; border-radius: 28px; background: #161a23; padding: 38px; box-shadow: 0 22px 54px rgba(22,26,35,.12); }
  .systems-map::before { position: absolute; inset: 0; background: var(--wave-url) 48% 48% / 720px auto no-repeat; content: ""; opacity: .38; }
  .systems-icon { position: relative; z-index: 1; display: grid; width: 88px; height: 88px; place-items: center; border-radius: 50%; background: #edebdf; color: #27414f; }
  .systems-route { position: relative; z-index: 1; display: grid; width: 100%; grid-template-columns: auto 1fr auto 1fr auto 1fr auto; align-items: center; gap: 9px; color: #edebdf; font-size: .875rem; font-weight: 750; }
  .systems-route i { height: 1px; background: rgba(225,254,102,.42); }
  .systems-route strong { display: grid; width: 58px; height: 58px; place-items: center; border-radius: 50%; background: #e1fe66; color: #161a23; font-size: .9rem; }

  @media (max-width: 900px) {
    .process-layout, .process-reverse, .systems-panel { grid-template-columns: 1fr; }
    .process-heading { position: static; }
    .context-visual { order: 2; width: min(100%,600px); }
    .pool-grid { grid-template-columns: 1fr; }
    .pool-grid article { min-height: 0; border-right: 0; border-bottom: 1px solid rgba(39,65,79,.16); padding-block: 34px; }
    .pool-grid article:last-child { border-bottom: 0; }
    .systems-map { width: min(100%,620px); }
  }

  @media (max-width: 520px) {
    .step-stack li { grid-template-columns: 54px 1fr; gap: 17px; }
    .step-stack .number-medallion { width: 54px; height: 54px; }
    .context-visual { min-height: 380px; padding: 30px 2px 24px 18px; }
    .context-visual::before { inset: 48px -3px 58px 26px; }
    .context-visual::after { inset: 40px 4px 66px 16px; }
    .context-kicker { margin-left: 14px; }
    .context-ledger > div { grid-template-columns: 34px 30px 1fr; gap: 10px; margin-inline: 18px; }
    .context-ledger > p { padding: 20px 18px; }
    .systems-panel { padding-inline: 0; }
    .systems-map { padding: 34px 24px; }
    .systems-route { grid-template-columns: 1fr; justify-items: center; }
    .systems-route i { width: 1px; height: 17px; }
  }
</style>
