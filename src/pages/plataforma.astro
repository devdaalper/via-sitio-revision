---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineIcon from '../components/LineIcon.astro';
import WaveBackdrop from '../components/WaveBackdrop.astro';
import { withBase } from '../utils/paths';

const steps = [
  { icon: 'publish', title: 'Requisición de vacante', copy: 'RH establece el perfil y las necesidades de la vacante.' },
  { icon: 'attract', title: 'Creación de perfil ideal', copy: 'V.IA crea el perfil del candidato ideal.' },
  { icon: 'publish', title: 'Publicación automatizada', copy: 'V.IA automatiza la publicación de la vacante en múltiples portales y redes.' },
  { icon: 'documents', title: 'Lectura inteligente', copy: 'V.IA entiende y extrae la información de los CVs.' },
  { icon: 'search', title: 'Matching con IA', copy: 'Clasifica por compatibilidad y aplica los criterios de la vacante.' },
  { icon: 'decide', title: 'Preselección', copy: 'V.IA ayuda a generar evaluaciones y filtros automatizados.' },
  { icon: 'interview', title: 'Programación de entrevistas', copy: 'V.IA realiza y programa entrevistas por chat o videollamada.' },
  { icon: 'folder', title: 'Recopilación de documentación', copy: 'V.IA valida la identidad y los registros del candidato directamente desde RENAPO e IMSS, sin procesos manuales.' },
  { icon: 'decide', title: 'Incorporación del colaborador', copy: 'Das la bienvenida al nuevo integrante de tu equipo.' },
] as const;

const candidateBenefits = [
  { icon: 'clarity', title: 'Claridad', copy: 'Cada candidato sabe exactamente en qué etapa está y qué sigue. Sin silencio, sin incertidumbre.' },
  { icon: 'brand', title: 'Marca empleadora', copy: 'La forma en que tratas a un candidato dice mucho de tu empresa. V.IA cuida esa experiencia en cada paso del proceso.' },
  { icon: 'relation', title: 'Relación', copy: 'Un rechazo no es un adiós. Los perfiles quedan activos para reconectarse cuando surja la oportunidad correcta.' },
] as const;
---

<BaseLayout
  title="Cómo funciona V.IA | De la vacante a la contratación"
  description="Conoce las nueve etapas que V.IA conecta y automatiza desde la requisición de la vacante hasta la incorporación."
  currentPath="/plataforma"
  connectFooter
>
  <section class="page-hero" aria-labelledby="page-title">
    <WaveBackdrop variant="b" class="hero-wave" />
    <div class="shell hero-content">
      <p class="eyebrow">Plataforma de reclutamiento impulsada con IA</p>
      <h1 id="page-title" class="page-title">Un proceso conectado, <mark class="marker">de la vacante a la contratación</mark></h1>
      <p class="lead"><span class="accent-text">V.IA</span> gestiona todo el ciclo de reclutamiento en un solo lugar: publica vacantes, filtra perfiles con IA, coordina entrevistas, valida documentos y acompaña el proceso hasta la nómina.</p>
    </div>
  </section>

  <section class="process-map-section" aria-labelledby="map-title">
    <h2 id="map-title" class="sr-only">Etapas del proceso de reclutamiento</h2>
    <div class="shell process-map">
      <ol>
        {steps.map((step, index) => (
          <li class:list={[index % 2 === 0 ? 'step-left' : 'step-right', index === steps.length - 1 && 'step-final']}>
            <article>
              <span class="step-label">{String(index + 1).padStart(2, '0')}</span>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </article>
            <span class="step-medallion" aria-hidden="true">
              <LineIcon name={step.icon} />
              <b>{String(index + 1).padStart(2, '0')}</b>
            </span>
          </li>
        ))}
      </ol>
    </div>
    <div class="shell map-action">
      <a class="btn-primary map-button" href={withBase('/contacto')}>Agenda una demostración <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="section-space candidate-section" aria-labelledby="candidate-title">
    <div class="shell candidate-heading">
      <p class="eyebrow">A lo largo de todo el proceso</p>
      <h2 id="candidate-title" class="section-title">Cada candidato importa, en cada etapa.</h2>
      <p class="lead"><span class="accent-text">V.IA</span> cuida la experiencia de cada persona que pasa por el proceso.</p>
    </div>
    <div class="shell candidate-band">
      {candidateBenefits.map((benefit) => (
        <article>
          <span aria-hidden="true"><LineIcon name={benefit.icon} /></span>
          <h3>{benefit.title}</h3>
          <p set:html={benefit.title === 'Claridad'
            ? '<strong>Cada candidato sabe exactamente en qué etapa está</strong> y qué sigue. Sin silencio, sin incertidumbre.'
            : benefit.title === 'Marca empleadora'
              ? '<strong>La forma en que tratas a un candidato dice mucho de tu empresa.</strong> <strong class="accent-text">V.IA</strong> cuida esa experiencia en cada paso del proceso.'
              : 'Un rechazo no es un adiós. <strong>Los perfiles quedan activos para reconectarse</strong> cuando surja la oportunidad correcta.'} />
        </article>
      ))}
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <WaveBackdrop variant="a" class="closing-wave" />
    <div class="shell closing-content">
      <p class="eyebrow eyebrow-on-dark">Dale a tu equipo de RH lo que necesita</p>
      <h2 id="closing-title" class="section-title section-title-on-dark">Conoce cómo <span class="accent-text">V.IA</span> <mark class="marker marker-on-dark">cambia tu reclutamiento</mark></h2>
      <p class="lead lead-on-dark">Ahorra tiempo, costos de operación y mejora la eficiencia de RH.</p>
      <a class="btn-primary" href={withBase('/contacto')}>Quiero una demostración <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .marker { display: inline; border-radius: .06em; background: #e1fe66; box-decoration-break: clone; color: #161a23; padding-inline: .06em; -webkit-box-decoration-break: clone; }
  .marker-on-dark { border-radius: .08em; background: #e1fe66; box-decoration-break: clone; color: #161a23; padding-inline: .08em; -webkit-box-decoration-break: clone; }
  :global(.accent-text) { color: #8dbd2f; font-weight: 800; }
  .page-hero { position: relative; overflow: hidden; padding-block: clamp(72px,9vw,118px); }
  :global(.hero-wave) { top: 50%; left: 50%; width: min(1050px,92vw); transform: translate(-50%,-50%); opacity: .23; }
  .hero-content { position: relative; display: grid; justify-items: center; text-align: center; }
  .hero-content .eyebrow { justify-content: center; }
  .hero-content .page-title { max-width: 18ch; }
  .hero-content .lead { max-width: 77ch; }
  .process-map-section { background: #edebdf; padding-block: clamp(68px,9vw,112px); }
  .map-heading { display: grid; justify-items: center; text-align: center; }
  .process-map { margin-top: 58px; }
  .process-map ol { position: relative; margin: 0; padding: 0; list-style: none; }
  .process-map ol::before { position: absolute; top: 54px; bottom: 54px; left: 50%; width: 1px; background: rgba(39,65,79,.23); content: ""; transform: translateX(-50%); }
  .process-map li { position: relative; display: grid; min-height: 218px; grid-template-columns: 1fr 112px 1fr; align-items: center; }
  .process-map article { position: relative; max-width: 470px; border: 1px solid rgba(39,65,79,.11); border-radius: 24px; background: #f9f9f9; box-shadow: 0 18px 42px rgba(22,26,35,.07); padding: 30px 34px; }
  .step-left article { grid-column: 1; justify-self: end; text-align: right; }
  .step-right article { grid-column: 3; justify-self: start; }
  .step-medallion { z-index: 2; display: grid; width: 82px; height: 82px; grid-column: 2; grid-row: 1; place-items: center; justify-self: center; border: 1px solid rgba(39,65,79,.14); border-radius: 50%; background: #f9f9f9; color: #27414f; box-shadow: 0 14px 30px rgba(22,26,35,.09); }
  .step-medallion :global(.line-icon) { width: 34px; height: 34px; stroke-width: 1.25; }
  .step-medallion b { display: none; }
  .step-final .step-medallion { background: #e1fe66; color: #161a23; }
  .step-label { display: block; margin-bottom: 10px; color: #27414f; font-size: .875rem; font-weight: 850; letter-spacing: .1em; }
  .process-map h3 { margin: 0; color: #8dbd2f; font-size: 1.05rem; font-weight: 780; line-height: 1.3; }
  .process-map p { margin: 10px 0 0; color: #27414f; font-size: 1rem; line-height: 1.55; }
  .map-action { display: grid; justify-items: center; margin-top: 48px; }
  .map-action .map-button { border-color: #e1fe66; background: #e1fe66; color: #161a23; }
  .map-action .map-button:hover { border-color: #8dbd2f; background: #8dbd2f; color: #161a23; }
  .candidate-heading { max-width: 800px; }
  .candidate-band { display: grid; grid-template-columns: repeat(3,1fr); margin-top: 56px; border-block: 1px solid rgba(39,65,79,.18); }
  .candidate-band article { border-right: 1px solid rgba(39,65,79,.16); padding: 38px clamp(28px,4vw,52px) 44px; }
  .candidate-band article:last-child { border-right: 0; }
  .candidate-band article > span { display: grid; width: 68px; height: 68px; place-items: center; border-radius: 50%; background: #edebdf; color: #27414f; }
  .candidate-band article > span :global(.line-icon) { width: 38px; height: 38px; stroke-width: 1.25; }
  .candidate-band h3 { margin: 25px 0 0; color: #8dbd2f; font-size: 1.05rem; font-weight: 780; line-height: 1.25; }
  .candidate-band p { margin: 12px 0 0; color: #27414f; font-size: 1rem; line-height: 1.62; }
  .closing-section { position: relative; overflow: hidden; margin: 12px 12px 0; border-radius: 34px 34px 0 0; background: #161a23; padding-block: clamp(76px,9vw,112px); }
  :global(.closing-wave) { top: -118%; right: -12%; width: 820px; opacity: .38; }
  .closing-section::after { position: absolute; z-index: 0; inset: 0; background: linear-gradient(to bottom, #161a23 0%, rgba(22,26,35,0) 22%, rgba(22,26,35,0) 76%, #161a23 100%); content: ""; pointer-events: none; }
  .closing-content { position: relative; z-index: 1; display: grid; justify-items: center; text-align: center; }
  .closing-content .section-title { max-width: 21ch; }
  .closing-content .lead { max-width: 54ch; }
  .closing-content .btn-primary { margin-top: 28px; }
  @media (max-width: 800px) {
    .process-map ol::before { left: 40px; }
    .process-map li { min-height: 0; grid-template-columns: 80px 1fr; padding-block: 18px; }
    .process-map article, .step-left article, .step-right article { max-width: none; grid-column: 2; grid-row: 1; justify-self: stretch; text-align: left; }
    .step-medallion { width: 64px; height: 64px; grid-column: 1; grid-row: 1; }
    .step-medallion :global(.line-icon) { width: 28px; height: 28px; }
    .candidate-band { grid-template-columns: 1fr; }
    .candidate-band article { border-right: 0; border-bottom: 1px solid rgba(39,65,79,.16); }
    .candidate-band article:last-child { border-bottom: 0; }
  }
  @media (max-width: 520px) {
    .page-hero { padding-block: 54px 70px; }
    :global(.hero-wave) { width: 720px; opacity: .18; }
    .process-map { width: min(100% - 24px,1200px); }
    .process-map ol::before { left: 28px; }
    .process-map li { grid-template-columns: 56px 1fr; gap: 10px; padding-block: 12px; }
    .process-map article { border-radius: 20px; padding: 24px 20px; }
    .step-medallion { width: 54px; height: 54px; }
    .step-medallion :global(.line-icon) { width: 24px; height: 24px; }
    .candidate-band article { padding-inline: 8px; }
    .closing-section { margin: 7px 7px 0; border-radius: 25px 25px 0 0; }
    :global(.closing-wave) { display: none; }
  }
</style>
