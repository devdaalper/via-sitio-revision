---
import LineIcon from './LineIcon.astro';
import { withBase } from '../utils/paths';

interface Step {
  icon: 'publish' | 'attract' | 'interview' | 'decide' | 'integrate';
  title: string;
  copy: string;
}

interface Props {
  steps: readonly Step[];
}

const { steps } = Astro.props;
---

<ol
  class="process-ledger"
  style={`--process-wave: url("${withBase('/assets/brand/wave-a.png')}")`}
>
  {steps.map((step, index) => (
    <li class:list={[index === steps.length - 1 && 'step-final']}>
      <span class="step-number">{String(index + 1).padStart(2, '0')}</span>
      <span class="step-icon" aria-hidden="true"><LineIcon name={step.icon} /></span>
      <div class="step-copy">
        <h3>{step.title}</h3>
        <p>{step.copy}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .process-ledger {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin: 0;
    border-radius: 30px;
    background: #edebdf;
    box-shadow: 0 24px 58px rgba(22, 26, 35, 0.09);
    padding: 0;
    list-style: none;
  }

  .process-ledger::before {
    position: absolute;
    z-index: -1;
    top: -160px;
    right: -260px;
    width: 650px;
    height: 440px;
    background: var(--process-wave) 50% 50% / contain no-repeat;
    content: "";
    opacity: 0.12;
    pointer-events: none;
  }

  .process-ledger li {
    display: grid;
    grid-template-columns: 42px 42px minmax(0, 1fr);
    align-items: center;
    gap: 18px;
    margin-inline: clamp(26px, 4vw, 42px);
    border-top: 1px solid rgba(39, 65, 79, 0.17);
    padding-block: clamp(20px, 2.2vw, 26px);
  }

  .process-ledger li:first-child {
    border-top: 0;
  }

  .step-number {
    align-self: start;
    color: #8dbd2f;
    font-size: 0.875rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    line-height: 1.3;
    padding-top: 3px;
  }

  .step-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    align-self: start;
    border: 1px solid rgba(39, 65, 79, 0.15);
    border-radius: 50%;
    background: rgba(249, 249, 249, 0.68);
    color: #27414f;
  }

  .step-icon :global(.line-icon) {
    width: 25px;
    height: 25px;
    stroke-width: 1.25;
  }

  .step-copy h3 {
    margin: 0;
    color: #161a23;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.3;
  }

  .step-copy p {
    max-width: 48ch;
    margin: 6px 0 0;
    color: #27414f;
    font-size: 1rem;
    line-height: 1.55;
  }

  .process-ledger .step-final {
    position: relative;
    margin-inline: 0;
    border-top: 0;
    background: #161a23;
    grid-template-columns: 42px 42px minmax(0, 1fr);
    padding: clamp(24px, 2.6vw, 30px) clamp(26px, 4vw, 42px);
  }

  .step-final .step-number {
    color: #e1fe66;
  }

  .step-final .step-icon {
    border-color: rgba(225, 254, 102, 0.34);
    background: #e1fe66;
    color: #161a23;
  }

  .step-final .step-copy h3 {
    color: #f9f9f9;
  }

  .step-final .step-copy p {
    color: rgba(237, 235, 223, 0.76);
  }

  @media (max-width: 700px) {
    .process-ledger {
      border-radius: 24px;
    }

    .process-ledger::before {
      top: -80px;
      right: -310px;
      opacity: 0.1;
    }

    .process-ledger li,
    .process-ledger .step-final {
      grid-template-columns: 32px 36px minmax(0, 1fr);
      gap: 12px;
    }

    .process-ledger li {
      margin-inline: 20px;
      padding-block: 21px;
    }

    .process-ledger .step-final {
      margin-inline: 0;
      padding: 23px 20px;
    }

    .step-icon {
      width: 36px;
      height: 36px;
    }

    .step-icon :global(.line-icon) {
      width: 22px;
      height: 22px;
    }

    .step-copy p {
      margin-top: 5px;
      line-height: 1.5;
    }
  }
</style>
