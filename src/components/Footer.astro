---
import { withBase } from '../utils/paths';

const socialLinks = [
  { label: 'Instagram', href: import.meta.env.PUBLIC_INSTAGRAM_URL, icon: 'instagram' },
  { label: 'Facebook', href: import.meta.env.PUBLIC_FACEBOOK_URL, icon: 'facebook' },
  { label: 'LinkedIn', href: import.meta.env.PUBLIC_LINKEDIN_URL, icon: 'linkedin' },
];
---

<footer id="site-footer" class="site-footer">
  <div class="footer-frame">
    <div class="footer-wave" style={`--wave-url: url("${withBase('/assets/brand/wave-a.png')}")`} aria-hidden="true"></div>

    <div class="shell footer-brand">
      <a class="footer-logo" href={withBase('/')} aria-label="v.ia, inicio">
        <img src={withBase('/assets/brand/logo-on-light.svg')} alt="v.ia — Contrata con inteligencia" />
      </a>
      <p>Plataforma de reclutamiento de punta a punta con IA.</p>
    </div>

    <div class="shell footer-grid">
      <nav aria-label="Navegación del pie">
        <span>Explora</span>
        <a href={withBase('/plataforma')}>Cómo funciona</a>
        <a href={withBase('/soluciones')}>Soluciones</a>
        <a href={withBase('/contacto')}>Contacto</a>
      </nav>

      <div class="legal-state">
        <span>Documentos legales</span>
        <p>Aviso de privacidad · Términos de uso</p>
      </div>

      <div class="footer-signature">
        <span>Síguenos</span>
        <div class="social-links" aria-label="Redes sociales">
          {socialLinks.map((social) => social.href ? (
            <a href={social.href} target="_blank" rel="noreferrer" aria-label={`${social.label} de v.ia`}>
              <span class="sr-only">{social.label}</span>
              {social.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7"/></svg>}
              {social.icon === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h3l.5-3H14V8.2c0-.9.3-1.7 1.8-1.7H18V3.8c-.7-.1-1.5-.2-2.4-.2-2.6 0-4.4 1.6-4.4 4.5V10H8v3h3.2v8z"/></svg>}
              {social.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="9" width="3" height="11"/><circle cx="5.5" cy="5.5" r="1.7"/><path d="M11 20V9h3v1.7c.8-1.2 2-2 3.8-2 3 0 4.2 2 4.2 5.3v6h-3v-5.4c0-1.8-.6-3-2.2-3-1.7 0-2.8 1.2-2.8 3.4v5z"/></svg>}
            </a>
          ) : (
            <span class="social-pending" aria-label={`${social.label}: enlace oficial pendiente`} title="Enlace oficial pendiente">
              {social.icon === 'instagram' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".7"/></svg>}
              {social.icon === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h3l.5-3H14V8.2c0-.9.3-1.7 1.8-1.7H18V3.8c-.7-.1-1.5-.2-2.4-.2-2.6 0-4.4 1.6-4.4 4.5V10H8v3h3.2v8z"/></svg>}
              {social.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="9" width="3" height="11"/><circle cx="5.5" cy="5.5" r="1.7"/><path d="M11 20V9h3v1.7c.8-1.2 2-2 3.8-2 3 0 4.2 2 4.2 5.3v6h-3v-5.4c0-1.8-.6-3-2.2-3-1.7 0-2.8 1.2-2.8 3.4v5z"/></svg>}
            </span>
          ))}
        </div>
        <p>Contrata con inteligencia</p>
      </div>
    </div>

    <div class="shell footer-bottom">
      <span>© 2026 v.ia</span>
      <span>Contrata con inteligencia</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #f9f9f9;
    padding-top: 12px;
  }

  .footer-frame {
    position: relative;
    width: calc(100% - 24px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: 34px 34px 0 0;
    background: #161a23;
    color: #edebdf;
    padding: clamp(62px, 7vw, 90px) 0 26px;
  }

  .footer-wave {
    position: absolute;
    top: -360px;
    right: -90px;
    left: -170px;
    height: 760px;
    background: var(--wave-url) center 42% / 1220px auto no-repeat;
    opacity: 0.52;
    pointer-events: none;
  }

  .footer-brand {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .footer-logo {
    display: flex;
    width: min(340px, 58vw);
    aspect-ratio: 18 / 11;
    align-items: center;
    justify-content: center;
  }

  .footer-logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .footer-brand > p {
    max-width: 48ch;
    margin: 10px 0 0;
    color: rgba(237, 235, 223, 0.72);
    font-size: 1rem;
    line-height: 1.6;
  }

  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: clamp(38px, 7vw, 90px);
    margin-top: clamp(46px, 6vw, 68px);
    border-top: 1px solid rgba(237, 235, 223, 0.17);
    padding-top: 34px;
  }

  .footer-grid nav,
  .legal-state,
  .footer-signature {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 11px;
  }

  .footer-grid nav > span,
  .legal-state > span,
  .footer-signature > span {
    color: #e1fe66;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer-grid nav a {
    color: #edebdf;
    font-size: 0.9375rem;
    font-weight: 650;
    text-decoration: none;
  }

  .footer-grid nav a:hover {
    color: #e1fe66;
  }

  .legal-state p,
  .footer-signature p {
    max-width: 34ch;
    margin: 0;
    color: rgba(237, 235, 223, 0.66);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .social-links {
    display: flex;
    gap: 10px;
  }

  .social-links a,
  .social-pending {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(237, 235, 223, 0.24);
    border-radius: 50%;
    color: #edebdf;
  }

  .social-links a:hover {
    border-color: #e1fe66;
    color: #e1fe66;
  }

  .social-links svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .social-links svg path,
  .social-links svg rect:first-child:not(:only-child) {
    fill: none;
  }

  .social-links svg path:not([d^="M14"]),
  .social-links svg rect:only-child {
    fill: currentColor;
    stroke: none;
  }

  .social-pending {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 40px;
    border-top: 1px solid rgba(237, 235, 223, 0.12);
    padding-top: 22px;
    color: rgba(237, 235, 223, 0.48);
    font-size: 0.875rem;
  }

  @media (max-width: 760px) {
    .site-footer {
      padding-top: 8px;
    }

    .footer-frame {
      width: calc(100% - 14px);
      border-radius: 24px 24px 0 0;
      padding-top: 54px;
    }

    .footer-wave {
      top: -250px;
      right: -350px;
      left: -330px;
      height: 650px;
      background-size: 930px auto;
      opacity: 0.58;
    }

    .footer-logo {
      width: min(240px, 76vw);
    }

    .footer-brand > p {
      max-width: 28ch;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 34px;
      margin-top: 44px;
      padding-top: 34px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
