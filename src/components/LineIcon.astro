---
interface Props {
  name:
    | 'publish'
    | 'attract'
    | 'interview'
    | 'decide'
    | 'integrate'
    | 'clarity'
    | 'brand'
    | 'relation'
    | 'systems'
    | 'search'
    | 'pool'
    | 'centralize'
    | 'data'
    | 'video'
    | 'documents'
    | 'government'
    | 'jobs'
    | 'payroll'
    | 'leader'
    | 'recruiter'
    | 'folder';
}

const { name } = Astro.props;
---

<svg class="line-icon" viewBox="0 0 32 32" aria-hidden="true">
  {name === 'publish' && (
    <>
      <path d="M8 4.5h11l5 5V27H8z" /><path d="M19 4.5V10h5M12 15h8M12 20h6" />
    </>
  )}
  {name === 'attract' && (
    <>
      <circle cx="12" cy="11" r="4" /><path d="M5.5 25c.8-5 3-7.5 6.5-7.5s5.7 2.5 6.5 7.5M23 8v8M19 12h8" />
    </>
  )}
  {name === 'interview' && (
    <>
      <path d="M5 6.5h22v15H15l-6 5v-5H5z" /><path d="M10 12h12M10 16h8" />
    </>
  )}
  {name === 'decide' && (
    <>
      <circle cx="16" cy="16" r="11" /><path d="m10.5 16 3.5 3.5 7.5-8" />
    </>
  )}
  {name === 'integrate' && (
    <>
      <path d="M5 26V11l11-6 11 6v15M10 26v-8h12v8M10 13h2M15 13h2M20 13h2" />
    </>
  )}
  {name === 'clarity' && (
    <>
      <circle cx="16" cy="16" r="11" /><path d="M16 10v7M16 22h.01" />
    </>
  )}
  {name === 'brand' && (
    <>
      <path d="m16 4 3.5 7.1 7.8 1.1-5.6 5.5 1.3 7.8-7-3.7-7 3.7 1.3-7.8-5.6-5.5 7.8-1.1z" />
    </>
  )}
  {name === 'relation' && (
    <>
      <path d="M12.8 19.2 9.6 22.4a4.5 4.5 0 0 1-6.4-6.4l4-4a4.5 4.5 0 0 1 6.4 0M19.2 12.8l3.2-3.2a4.5 4.5 0 1 1 6.4 6.4l-4 4a4.5 4.5 0 0 1-6.4 0M11 21l10-10" />
    </>
  )}
  {name === 'systems' && (
    <>
      <circle cx="7" cy="16" r="3" /><circle cx="25" cy="8" r="3" /><circle cx="25" cy="24" r="3" /><path d="M10 16h6M18.5 14l4-4M18.5 18l4 4" /><circle cx="17" cy="16" r="2" />
    </>
  )}
  {name === 'search' && (
    <>
      <circle cx="14" cy="14" r="8" /><path d="m20 20 7 7M11 14l2 2 4-5" />
    </>
  )}
  {name === 'pool' && (
    <>
      <circle cx="11" cy="11" r="4" /><circle cx="22" cy="12" r="3.2" /><path d="M4.5 26c.7-5 2.9-7.5 6.5-7.5s5.8 2.5 6.5 7.5M18 19c4.8 0 7.2 2.1 7.8 6" />
    </>
  )}
  {name === 'centralize' && (
    <>
      <rect x="4.5" y="5" width="23" height="22" rx="3" /><path d="M9 11h14M9 16h9M9 21h12" />
    </>
  )}
  {name === 'data' && (
    <>
      <path d="M6 26V16M13 26V10M20 26V14M27 26V6" /><path d="m5 11 7-4 7 3 8-6" />
    </>
  )}
  {name === 'video' && (
    <>
      <rect x="4" y="7" width="18" height="18" rx="3" /><path d="m22 13 6-3v12l-6-3zM12 12l6 4-6 4z" />
    </>
  )}
  {name === 'documents' && (
    <>
      <path d="M8 4.5h11l5 5V27H8z" /><path d="M19 4.5V10h5M11 17l3 3 7-7" />
    </>
  )}
  {name === 'government' && (
    <>
      <path d="m4 12 12-7 12 7M6 13h20M8 14v9M13 14v9M19 14v9M24 14v9M5 24h22M3 27h26" />
    </>
  )}
  {name === 'jobs' && (
    <>
      <rect x="4" y="9" width="24" height="17" rx="3" /><path d="M12 9V6h8v3M4 16h24M13 16v3h6v-3" />
    </>
  )}
  {name === 'payroll' && (
    <>
      <path d="M7 4h18v24l-4-2-5 2-5-2-4 2z" /><path d="M11 10h10M11 15h10M11 20h6" />
    </>
  )}
  {name === 'leader' && (
    <>
      <circle cx="16" cy="10" r="4" /><path d="M8 27c.7-6 3.3-9 8-9s7.3 3 8 9M5 8l3 1M27 8l-3 1M16 2v2" />
    </>
  )}
  {name === 'recruiter' && (
    <>
      <circle cx="11" cy="10" r="4" /><path d="M4.5 25c.8-5.2 3-7.8 6.5-7.8s5.7 2.6 6.5 7.8M20 13h8M24 9v8M20 23h7" />
    </>
  )}
  {name === 'folder' && (
    <>
      <path d="M4 9h9l3 3h12v15H4z" /><path d="M4 9V6h9l3 3h8" />
    </>
  )}
</svg>

<style>
  .line-icon {
    width: 32px;
    height: 32px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.55;
  }
</style>
